model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	directLakeBehavior: directLakeOnly
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DatabaseQuery"]

annotation PBI_ProTooling = ["TMDL"]

ref table Set
ref table Part
ref table Colour
ref table Theme
ref table Minifig
ref table Member
ref table Year
ref table 'Set Parts'
ref table 'Set Minifigs'
ref table 'Member Sets'
